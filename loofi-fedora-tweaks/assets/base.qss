/* Structural theme. Palette values are substituted by ThemeManager. */

/* Minimal application baseline: retain the QApplication system font.
 * The palette owns the window canvas; nested reading widgets stay transparent
 * unless they are an intentional surface below.
 */
QWidget {
    color: $color_text;
    background-color: transparent;
}

QMainWindow,
QDialog,
QAbstractScrollArea {
    background-color: $color_window;
}

QAbstractItemView {
    background-color: $color_surface;
    alternate-background-color: $color_surface_raised;
}

QLabel {
    background-color: transparent;
}

QDialog, QMenu, QToolTip {
    background-color: $color_surface;
    color: $color_text;
    border: $border_width solid $color_border;
}

QToolTip {
    padding: $space_2;
    border-radius: $radius_control;
}

/* Shell and navigation */
QWidget#sidebarContainer,
QTreeWidget#sidebar,
QTreeWidget#destinationSidebar {
    background-color: $color_surface;
    border: none;
    outline: none;
}

QTreeWidget#sidebar::item,
QTreeWidget#destinationSidebar::item {
    min-height: $navigation_row_min_height;
    padding: 0 $space_3;
    margin: $space_1;
    border-radius: $radius_control;
    color: $color_text_muted;
}

QTreeWidget#sidebar::item:hover,
QTreeWidget#destinationSidebar::item:hover {
    background-color: $color_hover;
    color: $color_text;
}

QTreeWidget#sidebar::item:selected,
QTreeWidget#destinationSidebar::item:selected {
    background-color: $color_selected;
    color: $color_accent;
    border-left: $focus_width solid $color_accent;
}

QTreeWidget#sidebar::item:disabled,
QTreeWidget#destinationSidebar::item:disabled {
    background-color: $color_disabled_surface;
    color: $color_disabled_text;
}

QTreeWidget#destinationSidebar[collapsed="true"]::item {
    padding: 0;
    margin: $space_1;
}

QToolButton#sidebarToggle,
QPushButton#globalSearchAffordance {
    min-height: $control_min_height;
}

QToolButton#sidebarToggle {
    padding: 0 $space_2;
    background-color: transparent;
    color: $color_text_muted;
    border-color: transparent;
}

QToolButton#sidebarToggle:hover,
QToolButton#sidebarToggle:focus {
    background-color: $color_hover;
    color: $color_text;
    border-color: $color_accent;
}

QPushButton#globalSearchAffordance {
    min-width: $control_min_height;
    text-align: left;
}

QFrame#pageHeader,
QFrame#breadcrumbBar,
QFrame#statusBar {
    background-color: $color_surface;
    border-bottom: $border_width solid $color_border;
}

QLabel#pageHeaderTitle,
QLabel#bcPage {
    color: $color_text;
    font-weight: $page_title_weight;
}

QLabel#pageHeaderDescription,
QLabel#bcDesc,
QLabel[objectName="descriptionText"],
QLabel[objectName="mutedText"] {
    color: $color_text_muted;
    font-weight: $supporting_weight;
}

/* Cards and named content surfaces */
QFrame#contentSection,
QFrame#dashboardCard,
QFrame#routeCard,
QFrame[routeCard="true"],
QFrame#homeState,
QFrame#profileCard,
QFrame#monitorCard,
QFrame#hwCard {
    background-color: $color_surface;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}

QFrame#routeCard:hover,
QFrame[routeCard="true"]:hover {
    background-color: $color_hover;
    border-color: $color_accent;
}

QFrame#routeCard:focus,
QFrame[routeCard="true"]:focus {
    border: $focus_width solid $color_focus;
}

QLabel#routeCardTitle,
QLabel#stateTitle,
QLabel#homeSectionTitle {
    color: $color_text;
    font-weight: $section_title_weight;
}

QLabel#routeCardDescription,
QLabel#stateMessage,
QLabel#homeSubheader,
QLabel#supportBundleDescription,
QLabel#settingRowDescription {
    color: $color_text_muted;
}

QLabel#settingRowTitle {
    color: $color_text;
    font-weight: $section_title_weight;
}

QLabel#settingRowFeedback[feedbackKind="saved"] {
    color: $color_success_text;
}

QLabel#settingRowFeedback[feedbackKind="changed"],
QLabel#settingRowFeedback[feedbackKind="restart"] {
    color: $color_warning_text;
}

QLabel#settingRowFeedback[feedbackKind="dependency"] {
    color: $color_text_muted;
}

QLabel#settingRowFeedback[feedbackKind="error"] {
    color: $color_error_text;
}

/* Controls: geometry is shared, semantic roles carry emphasis. */
QPushButton,
QToolButton,
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: $control_min_height;
    padding: 0 $space_3;
    border: $border_width solid $color_border;
    border-radius: $radius_control;
    background-color: $color_surface_raised;
    color: $color_text;
}

QPushButton,
QToolButton {
    font-weight: $control_weight;
}

QPushButton:hover,
QToolButton:hover,
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover {
    background-color: $color_hover;
    border-color: $color_accent;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: $color_selected;
}

QPushButton:disabled,
QToolButton:disabled,
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled {
    background-color: $color_disabled_surface;
    color: $color_disabled_text;
    border-color: $color_disabled_text;
}

QPushButton:focus,
QToolButton:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QCheckBox:focus,
QRadioButton:focus,
QListWidget:focus,
QTreeWidget:focus,
QTableView:focus {
    border: $focus_width solid $color_focus;
}

QPushButton[objectName="primaryAction"] {
    background-color: $color_accent;
    color: $color_accent_text;
    border-color: $color_accent;
}

QPushButton[objectName="primaryAction"]:hover {
    background-color: $color_selected;
    color: $color_text;
}

QPushButton[objectName="dangerAction"] {
    background-color: $color_error_surface;
    color: $color_error_text;
    border-color: $color_error;
}

QPushButton[objectName="dangerAction"]:hover {
    background-color: $color_error;
    color: $color_window;
}

/* Content-level tabs remain supported until the shared component phase. */
QTabWidget::pane {
    border: $border_width solid $color_border;
    border-radius: $radius_card;
    background-color: $color_surface;
}

QTabBar::tab {
    min-height: $control_min_height;
    padding: 0 $space_4;
    color: $color_text_muted;
    border-bottom: $focus_width solid transparent;
}

QTabBar::tab:hover:!selected {
    background-color: $color_hover;
    color: $color_text;
}

QTabBar::tab:selected {
    color: $color_accent;
    border-bottom-color: $color_accent;
}

/* Status and feedback: text remains present; colour is supplementary. */
QFrame#resultBanner,
QFrame#rebootBanner,
QFrame[presentationState="loading"],
QFrame[presentationState="empty"],
QFrame[presentationState="unavailable"] {
    background-color: $color_surface_raised;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}

QFrame#resultBanner[resultKind="success"],
QFrame[presentationState="success"] {
    background-color: $color_success_surface;
    color: $color_success_text;
    border-color: $color_success;
}

QFrame#resultBanner[resultKind="warning"],
QFrame[presentationState="warning"] {
    background-color: $color_warning_surface;
    color: $color_warning_text;
    border-color: $color_warning;
}

QFrame#resultBanner[resultKind="error"],
QFrame[presentationState="error"] {
    background-color: $color_error_surface;
    color: $color_error_text;
    border-color: $color_error;
}

QLabel#riskBadge[level="low"] {
    background-color: $color_success_surface;
    color: $color_success_text;
    border: $border_width solid $color_success;
}

QLabel#riskBadge[level="medium"] {
    background-color: $color_warning_surface;
    color: $color_warning_text;
    border: $border_width solid $color_warning;
}

QLabel#riskBadge[level="high"],
QLabel#statusText[toast="error"] {
    background-color: $color_error_surface;
    color: $color_error_text;
    border: $border_width solid $color_error;
}

QLabel#statusText[toast="success"] {
    background-color: $color_success_surface;
    color: $color_success_text;
    border: $border_width solid $color_success;
}

QLabel#taskResultHeader,
QLabel#taskRiskBadge {
    font-weight: $section_title_weight;
}

QLabel#taskResultHeader[resultKind="success"],
QLabel#taskRiskBadge[riskLevel="low"] {
    color: $color_success_text;
    border-color: $color_success;
}

QLabel#taskResultHeader[resultKind="error"],
QLabel#taskRiskBadge[riskLevel="high"] {
    color: $color_error_text;
    border-color: $color_error;
}

QLabel#taskRiskBadge[riskLevel="medium"],
QLabel#taskRollbackHint {
    color: $color_warning_text;
    border-color: $color_warning;
}

QLabel#taskRiskBadge[riskLevel="info"] {
    color: $color_text_muted;
    border-color: $color_border;
}

QLabel#taskRiskBadge {
    padding: $space_1;
    border: $border_width solid $color_border;
    border-radius: $radius_control;
}

QLabel#taskResultMessage {
    color: $color_text_muted;
}

QLabel#taskCommandPreview {
    padding: $space_2;
    border-radius: $radius_control;
    background-color: $color_surface_raised;
    color: $color_text;
    font-family: $code_family;
}

QPushButton#taskCommandPreviewToggle {
    min-height: 0;
    padding: 0;
    color: $color_accent;
    border: none;
    background: transparent;
    text-align: left;
}

QLabel#readinessBadge {
    padding: $space_1 $space_2;
    border: $border_width solid $color_border;
    border-radius: $radius_control;
    font-weight: $section_title_weight;
}

QLabel#readinessBadge[severity="success"],
QLabel#readinessBadge[severity="low"] {
    color: $color_success_text;
    border-color: $color_success;
}

QLabel#readinessBadge[severity="warning"],
QLabel#readinessBadge[severity="medium"] {
    color: $color_warning_text;
    border-color: $color_warning;
}

QLabel#readinessBadge[severity="error"],
QLabel#readinessBadge[severity="high"] {
    color: $color_error_text;
    border-color: $color_error;
}

QLabel#readinessBadge[severity="accent"],
QLabel#readinessBadge[severity="info"] {
    color: $color_accent;
    border-color: $color_accent;
}

QLabel#readinessMuted,
QLabel#readinessCode {
    color: $color_text_muted;
}

QLabel#readinessCommand,
QLabel#readinessCode {
    font-family: $code_family;
}

QLabel#readinessCommand {
    padding: $space_2;
    border-radius: $radius_control;
    background-color: $color_surface_raised;
    color: $color_text;
}

QProgressBar {
    min-height: $space_3;
    border: $border_width solid $color_border;
    border-radius: $radius_control;
    background-color: $color_surface_raised;
    color: $color_text;
    text-align: center;
}

QProgressBar::chunk {
    background-color: $color_accent;
    border-radius: $radius_control;
}

QTextEdit#outputArea,
QTextEdit#confirmPreview,
QTextEdit#supportBundlePreview,
QLabel[code="true"] {
    font-family: $code_family;
}

QTextEdit#supportBundlePreview {
    background-color: $color_surface_raised;
    color: $color_text_muted;
}

/* Shared v16 component library. */
QWidget#pageScaffold,
QWidget#contentColumn,
QWidget#actionBar {
    background-color: transparent;
}

QFrame#componentCard,
QFrame#clickableCard,
QFrame#definitionList,
QFrame[componentCard="true"] {
    background-color: $color_surface;
    color: $color_text;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}

QFrame#clickableCard:hover,
QFrame[clickableCard="true"]:hover {
    background-color: $color_hover;
    color: $color_text;
    border-color: $color_accent;
}

QFrame#clickableCard:focus,
QFrame[clickableCard="true"]:focus {
    border: $focus_width solid $color_focus;
}

QFrame#clickableCard[interactionState="active"],
QFrame[clickableCard="true"][interactionState="active"] {
    background-color: $color_selected;
    color: $color_text;
    border-color: $color_accent;
}

QFrame#clickableCard:disabled,
QFrame[clickableCard="true"]:disabled {
    background-color: $color_disabled_surface;
    color: $color_disabled_text;
    border-color: $color_disabled_text;
}

QFrame#homePrimaryRecommendation,
QFrame#homePrimaryTask {
    background-color: $color_selected;
    border: $focus_width solid $color_accent;
    border-radius: $radius_card;
}

QFrame#homeAttentionItem {
    background-color: $color_surface;
}

QLabel#cardTitle,
QLabel#noticeTitle,
QLabel#definitionLabel {
    color: $color_text;
    font-weight: $section_title_weight;
}

QLabel#cardDescription,
QLabel#noticeMessage,
QLabel#definitionValue {
    color: $color_text_muted;
}

QWidget#definitionRow {
    background-color: transparent;
    border-bottom: $border_width solid $color_border;
}

QPushButton[buttonRole="primary"],
QPushButton#componentButton[buttonRole="primary"] {
    background-color: $color_accent;
    color: $color_accent_text;
    border-color: $color_accent;
}

QPushButton[buttonRole="secondary"],
QPushButton#componentButton[buttonRole="secondary"] {
    background-color: $color_surface_raised;
    color: $color_text;
    border-color: $color_border;
}

QPushButton[buttonRole="ghost"],
QPushButton#componentButton[buttonRole="ghost"],
QPushButton[buttonRole="quiet"],
QPushButton#componentButton[buttonRole="quiet"],
QToolButton[buttonRole="ghost"] {
    background-color: transparent;
    color: $color_accent;
    border-color: transparent;
}

QPushButton[buttonRole="danger"],
QPushButton#componentButton[buttonRole="danger"],
QPushButton[buttonRole="destructive"],
QPushButton#componentButton[buttonRole="destructive"] {
    background-color: $color_error_surface;
    color: $color_error_text;
    border-color: $color_error;
}

QPushButton[buttonRole="primary"]:hover,
QPushButton#componentButton[buttonRole="primary"]:hover,
QPushButton[buttonRole="secondary"]:hover,
QPushButton#componentButton[buttonRole="secondary"]:hover,
QPushButton[buttonRole="ghost"]:hover,
QPushButton#componentButton[buttonRole="ghost"]:hover,
QPushButton[buttonRole="quiet"]:hover,
QPushButton#componentButton[buttonRole="quiet"]:hover,
QPushButton[buttonRole="retry"]:hover,
QPushButton#componentButton[buttonRole="retry"]:hover,
QToolButton[buttonRole="ghost"]:hover {
    background-color: $color_hover;
    color: $color_text;
    border-color: $color_accent;
}

QPushButton[buttonRole="danger"]:hover,
QPushButton#componentButton[buttonRole="danger"]:hover,
QPushButton[buttonRole="destructive"]:hover,
QPushButton#componentButton[buttonRole="destructive"]:hover {
    background-color: $color_error_surface;
    color: $color_error_text;
}

QPushButton[interactionState="loading"],
QPushButton#componentButton[interactionState="loading"] {
    background-color: $color_disabled_surface;
    color: $color_disabled_text;
    border-color: $color_border;
}

QPushButton[interactionState="error"],
QPushButton#componentButton[interactionState="error"] {
    background-color: $color_error_surface;
    color: $color_error_text;
    border-color: $color_error;
}

QPushButton[interactionState="success"],
QPushButton#componentButton[interactionState="success"] {
    background-color: $color_success_surface;
    color: $color_success_text;
    border-color: $color_success;
}

QFrame#sectionNavigator {
    background-color: transparent;
    color: $color_text;
    border: none;
}

QFrame#sectionGroupOverview {
    background-color: $color_surface;
    color: $color_text;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}

QLabel#sectionOverviewTitle {
    color: $color_text;
    font-weight: $section_title_weight;
}

QLabel#sectionOverviewDescription,
QLabel#sectionMatchCount {
    color: $color_text_muted;
}

QPushButton#sectionGroupButton {
    text-align: left;
    background-color: $color_surface_raised;
}

QFrame#sectionNoResults {
    background-color: $color_surface_raised;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}

QListWidget#sectionRail {
    background-color: $color_surface;
    color: $color_text;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
    outline: none;
}

QListWidget#sectionRail::item {
    min-height: $navigation_row_min_height;
    padding: 0 $space_3;
    margin: $space_1;
    border-radius: $radius_control;
    color: $color_text_muted;
}

QListWidget#sectionRail::item:hover {
    background-color: $color_hover;
    color: $color_text;
}

QListWidget#sectionRail::item:selected {
    background-color: $color_selected;
    color: $color_accent;
    border-left: $focus_width solid $color_accent;
}

QComboBox#sectionSelector {
    min-height: $navigation_row_min_height;
}

QFrame#statusBadge,
QFrame#inlineNotice {
    background-color: $color_surface_raised;
    color: $color_text;
    border: $border_width solid $color_border;
    border-radius: $radius_control;
}

QFrame#sectionHeader {
    background-color: transparent;
    border-bottom: $border_width solid $color_border;
}

QLabel#sectionHeaderTitle,
QLabel#applicationRowTitle,
QLabel#workItemTitle {
    color: $color_text;
    font-weight: $section_title_weight;
}

QLabel#sectionHeaderDescription,
QLabel#applicationRowDescription,
QLabel#applicationRowSource,
QLabel#workItemSummary {
    color: $color_text_muted;
}

QFrame#applicationRow,
QFrame#actionCenterWorkItem,
QFrame#taskSummary,
QFrame#confirmationRiskPanel {
    background-color: $color_surface;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}

QFrame#actionCenterWorkItem:hover,
QFrame#actionCenterWorkItem:focus,
QFrame#actionCenterWorkItem[selected="true"] {
    background-color: $color_selected;
    border-color: $color_accent;
}

QFrame#errorState {
    background-color: $color_error_surface;
    border: $border_width solid $color_error;
    border-radius: $radius_card;
}

QFrame#successState {
    background-color: $color_success_surface;
    border: $border_width solid $color_success;
    border-radius: $radius_card;
}

QFrame#disabledState {
    background-color: $color_disabled_surface;
    color: $color_disabled_text;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}

QFrame#inlineNotice {
    border-radius: $radius_card;
}

QFrame#statusBadge[statusKind="success"],
QFrame#inlineNotice[noticeKind="success"] {
    background-color: $color_success_surface;
    color: $color_success_text;
    border-color: $color_success;
}

QFrame#statusBadge[statusKind="success"] QLabel,
QFrame#inlineNotice[noticeKind="success"] QLabel {
    color: $color_success_text;
}

QFrame#statusBadge[statusKind="warning"],
QFrame#inlineNotice[noticeKind="warning"] {
    background-color: $color_warning_surface;
    color: $color_warning_text;
    border-color: $color_warning;
}

QFrame#statusBadge[statusKind="warning"] QLabel,
QFrame#inlineNotice[noticeKind="warning"] QLabel {
    color: $color_warning_text;
}

QFrame#statusBadge[statusKind="error"],
QFrame#inlineNotice[noticeKind="error"] {
    background-color: $color_error_surface;
    color: $color_error_text;
    border-color: $color_error;
}

QFrame#statusBadge[statusKind="error"] QLabel,
QFrame#inlineNotice[noticeKind="error"] QLabel {
    color: $color_error_text;
}

QFrame#statusBadge[statusKind="info"],
QFrame#inlineNotice[noticeKind="info"] {
    border-color: $color_accent;
}

QToolButton#disclosureButton {
    text-align: left;
}


/* Loofi control panel: quiet surfaces and compact divided settings. */
QLabel#settingRowValue,
QLabel#tweaksResults,
QLabel#installMatchSummary,
QLabel#applicationStatusLabel {
    color: $color_text_muted;
}
QToolButton#tweakFavorite,
QToolButton#tweakRowActions {
    padding: $space_1;
    min-width: $control_min_height;
    min-height: $control_min_height;
}
QFrame#tweaksFilters QPushButton:checked,
QToolButton#tweakFavorite:checked,
QPushButton#tweakSegment:checked,
QFrame#healthSymptomCard[selected="true"] {
    background-color: $color_accent;
    color: $color_accent_text;
    border-color: $color_accent;
}
QFrame#healthSymptomCard {
    background-color: $color_surface;
    border: $border_width solid $color_border;
    border-radius: $radius_card;
}
QFrame#healthSymptomCard:hover {
    background-color: $color_hover;
}
QFrame#healthSymptomCard:focus {
    border: $focus_width solid $color_accent;
}
QLabel#applicationSourceBadge {
    background-color: $color_surface_raised;
    color: $color_text;
    border: $border_width solid $color_border;
    border-radius: $radius_control;
    padding: $space_1 $space_2;
}
QFrame#installReviewCard {
    background-color: $color_surface_raised;
    border-top: $border_width solid $color_border;
}
QPushButton#tweakSegment {
    padding: $space_1 $space_2;
}
QCheckBox#tweakSwitch:disabled {
    color: $color_disabled_text;
}

QFrame#healthSymptomCard[selected="true"] QLabel {
    color: $color_accent_text;
}

/* Reading surfaces use hierarchy rather than a frame around every row. */
QFrame#componentCard[surfaceRole="toolbar"],
QFrame#tweaksFilters,
QFrame[componentCard="true"][surfaceRole="toolbar"] {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QFrame[componentCard="true"][surfaceRole="settings"] {
    background-color: $color_surface;
    border: none;
    border-radius: $radius_card;
}
QFrame[settingRow="true"] {
    background-color: transparent;
    border: none;
    border-bottom: $border_width solid $color_border;
    border-radius: 0;
}
QLabel#settingRowFeedback[feedbackKind="saved"] {
    color: $color_success;
}
QLabel#settingRowFeedback[feedbackKind="changed"],
QLabel#settingRowFeedback[feedbackKind="restart"] {
    color: $color_warning;
}
QLabel#settingRowFeedback[feedbackKind="error"] {
    color: $color_error;
}
QWidget#applicationRow {
    background-color: $color_surface;
    border-bottom: $border_width solid $color_border;
}
QListWidget#installApplicationList {
    border: none;
    background-color: $color_surface;
    outline: none;
}
QListWidget#installApplicationList::item {
    padding: 0;
    border: none;
}
QLabel#applicationRowScope,
QLabel#applicationRowIdentifier {
    color: $color_text_muted;
}
QFrame#installReviewCard {
    border: none;
    border-top: $border_width solid $color_border;
    border-radius: 0;
}
QLabel#sidebarBrandTitle {
    color: $color_text;
    font-weight: $page_title_weight;
}
QToolButton#sidebarToolsToggle,
QPushButton#sidebarToolsToggle,
QPushButton#sidebarSettings,
QToolButton#sidebarSettings {
    min-height: $navigation_row_min_height;
    background-color: transparent;
    color: $color_text_muted;
    border-color: transparent;
    text-align: left;
}
QToolButton#sidebarToolsToggle:hover,
QPushButton#sidebarToolsToggle:hover,
QPushButton#sidebarSettings:hover,
QToolButton#sidebarSettings:hover {
    background-color: $color_hover;
    color: $color_text;
}
QPushButton#sidebarSettings:checked,
QToolButton#sidebarSettings:checked {
    background-color: $color_selected;
    color: $color_accent;
    border-left: $focus_width solid $color_accent;
}
QLabel#dashboardMetricValue {
    color: $color_accent;
    font-weight: $page_title_weight;
}
QFrame#pageHeader {
    background-color: $color_window;
    border: none;
}
QFrame#statusBar {
    background-color: $color_surface;
    border: none;
    border-top: $border_width solid $color_border;
}
QTreeWidget#destinationSidebar::branch {
    background-color: transparent;
}
QMenu::item {
    min-height: $control_min_height;
    padding: 0 $space_4;
}
QMenu::item:selected {
    background-color: $color_selected;
    color: $color_accent;
}
QHeaderView::section {
    background-color: $color_surface_raised;
    color: $color_text_muted;
    padding: $space_2 $space_3;
    border: none;
    border-bottom: $border_width solid $color_border;
}
QGroupBox {
    border: $border_width solid $color_border;
    border-radius: $radius_card;
    margin-top: $space_6;
    padding: $space_4;
}
QGroupBox::title {
    color: $color_text;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 $space_2;
}

QFrame[componentCard="true"][surfaceRole="source"] {
    border: none;
    border-top: $focus_width solid $color_accent;
}
QFrame[componentCard="true"][surfaceRole="workflow"] {
    border: none;
    border-left: $focus_width solid $color_accent;
}
QLabel[supportingText="true"] {
    color: $color_text_muted;
    font-weight: $supporting_weight;
}

QCheckBox, QRadioButton {
    min-height: $control_min_height;
    spacing: $space_2;
}
QCheckBox::indicator:unchecked {
    width: 20px;
    height: 20px;
    background-color: $color_surface_raised;
    border: $border_width solid $color_border;
    border-radius: $space_1;
}
QCheckBox::indicator:disabled {
    background-color: $color_disabled_surface;
    border-color: $color_disabled_text;
}
QScrollBar:vertical {
    background-color: $color_window;
    width: 12px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: $color_border;
    min-height: $space_8;
    border-radius: $radius_control;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: $color_accent;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* Caller-assigned control IDs retain role-specific keyboard and run states. */
QPushButton[buttonRole="primary"]:pressed {
    background-color: $color_selected;
    color: $color_text;
}
QPushButton[buttonRole="danger"]:pressed,
QPushButton[buttonRole="destructive"]:pressed {
    background-color: $color_error;
    color: $color_window;
}
QPushButton[buttonRole]:focus {
    border: $focus_width solid $color_focus;
}
QPushButton[buttonRole]:disabled {
    background-color: $color_disabled_surface;
    color: $color_disabled_text;
    border-color: $color_border;
}
